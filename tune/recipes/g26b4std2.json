{
  "_about": "g26b4std with stopping when cut in on weighted 6 instead of 4.5 (2026-10-29, started from the Tune tab). g26b4std is v1's recipe on the standard Gemma 4 26B-A4B; it stops for a cut-in later than v1 live (6/9, median 1.67 s against 8/9, 1.35 s). Only a weight changes, so it reuses g26b4std's training cache. Tested at 0.7, where g26b4std's pace matched v1's, with v1's carry-on bar.",
  "name": "g26b4std2",
  "base": "gemma4a4bstd",
  "writer": "original",
  "prompt": "partner",
  "export_as": "talkme-g26b4std2-partner-gemma4a4bstd.gguf",
  "dialogues": [],
  "dialogue_files": [
    {
      "file": "out/dial_run10.jsonl",
      "per": 2,
      "filter": "no_unknown"
    },
    {
      "file": "out/dial_run10.jsonl",
      "per": 2,
      "filter": "only_unknown",
      "limit": 40
    },
    {
      "file": "out/dial_partner2.jsonl",
      "per": 2
    },
    {
      "file": "out/dial_partner.jsonl",
      "per": 1,
      "filter": "no_shared_life"
    }
  ],
  "build": {
    "per": 2,
    "timing": "mixed",
    "max_ticks": 460,
    "fillers": "Mm-hm.|Yeah.|Right.|Uh-huh.|Oh yeah?|Oh wow.|Totally.|Oh nice.|Huh.|Ha, yeah.|Oh no.|Really?",
    "filler_min_talk": 3,
    "filler_gap": 5,
    "nudge_quiet": "2.6,5.5",
    "sentence_pauses": 0.3,
    "even_chunks": true
  },
  "mix": [
    {
      "file": "out/calls_oto_all.jsonl",
      "take": 250
    },
    {
      "file": "out/calls_built_r5_nodecline.jsonl",
      "take": 300,
      "filter": "hazard_only"
    },
    {
      "file": "out/calls_train_masked_nodecline.jsonl",
      "take": 100,
      "filter": "hazard_only"
    },
    "out/calls_special_r8_nodecline.jsonl"
  ],
  "weights": {
    "continuer": 2.05,
    "hazard_start": 5,
    "hazard": 2.2,
    "barge_stop": 6,
    "listen_done": 1.9,
    "speak": 0.5,
    "speak_on": 3
  },
  "real_mid_reply_off": true,
  "train": {
    "rank": 32,
    "alpha": 64,
    "steps": 600,
    "batch": 4,
    "lr": 0.0002,
    "chunk": 128,
    "max_tokens": 8000
  },
  "tests": {
    "quiz": true,
    "yap": 24,
    "ours": true,
    "live": true,
    "listen_p": 0.7,
    "compare": [
      "g26b4_bar9",
      "g26b4std",
      "g26b4std07"
    ],
    "carry_on_p": 0.9
  },
  "mute_service_greetings": true,
  "cache": "g26b4std"
}
