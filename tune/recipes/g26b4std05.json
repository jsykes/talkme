{
  "_about": "g26b4std's adapter tested at listen threshold 0.5 instead of 0.6 (2026-10-28): the 0.6 and the 0.9 bar were tuned on the heretic base, and on the standard base it takes the turn later than v1. Same adapter file; only the tests run.",
  "name": "g26b4std05",
  "base": "gemma4a4bstd",
  "writer": "original",
  "prompt": "partner",
  "export_as": "talkme-partner-v1-gemma4a4bstd.gguf",
  "label": "Partner v1 (standard Gemma)",
  "dialogues": [],
  "dialogue_files": [
    {
      "file": "out/dial_run10.jsonl",
      "per": 2,
      "filter": "no_unknown"
    },
    {
      "file": "out/dial_run10.jsonl",
      "per": 2,
      "filter": "only_unknown",
      "limit": 40
    },
    {
      "file": "out/dial_partner2.jsonl",
      "per": 2
    },
    {
      "file": "out/dial_partner.jsonl",
      "per": 1,
      "filter": "no_shared_life"
    }
  ],
  "build": {
    "per": 2,
    "timing": "mixed",
    "max_ticks": 460,
    "fillers": "Mm-hm.|Yeah.|Right.|Uh-huh.|Oh yeah?|Oh wow.|Totally.|Oh nice.|Huh.|Ha, yeah.|Oh no.|Really?",
    "filler_min_talk": 3,
    "filler_gap": 5,
    "nudge_quiet": "2.6,5.5",
    "sentence_pauses": 0.3,
    "even_chunks": true
  },
  "mix": [
    {
      "file": "out/calls_oto_all.jsonl",
      "take": 250
    },
    {
      "file": "out/calls_built_r5_nodecline.jsonl",
      "take": 300,
      "filter": "hazard_only"
    },
    {
      "file": "out/calls_train_masked_nodecline.jsonl",
      "take": 100,
      "filter": "hazard_only"
    },
    "out/calls_special_r8_nodecline.jsonl"
  ],
  "weights": {
    "continuer": 2.05,
    "hazard_start": 5,
    "hazard": 2.2,
    "barge_stop": 4.5,
    "listen_done": 1.9,
    "speak": 0.5,
    "speak_on": 3
  },
  "real_mid_reply_off": true,
  "train": {
    "rank": 32,
    "alpha": 64,
    "steps": 600,
    "batch": 4,
    "lr": 0.0002,
    "chunk": 128,
    "max_tokens": 8000
  },
  "tests": {
    "quiz": false,
    "yap": 24,
    "ours": true,
    "live": true,
    "listen_p": 0.5,
    "compare": [
      "g26b4_bar9",
      "g26b4std",
      "g26b4v1"
    ],
    "carry_on_p": 0.9
  },
  "mute_service_greetings": true
}
